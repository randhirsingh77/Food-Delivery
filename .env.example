# Foodie — copy this file to .env and set the values for your setup.
#
# VITE_API_URL tells the app where the backend lives. Leave it unset to
# run in demo mode: the app uses its built-in demo dataset and no backend
# or login is needed. Set it to talk to a real backend over HTTP with
# JWT login instead.
#
# Local development — the foodie-server listens on port 4000 by default:
VITE_API_URL=http://localhost:4000
#
# Production — the live backend on Render (already set for production
# builds in .env.production):
# VITE_API_URL=https://foodie-server-kwl6.onrender.com
